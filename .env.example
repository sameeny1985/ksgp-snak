# کپی کن به .env و مقادیر واقعی را بگذار
PORT=3000
SESSION_SECRET=یک_رشته_خیلی_تصادفی_و_بلند_اینجا_بگذار_حداقل_۳۲_کاراکتر

# از Google Cloud Console بگیر (راهنما در README)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# آدرس سایت بعد از دیپلوی روی Render (مهم برای OAuth)
# مثال: https://snake-ksgp.onrender.com
CALLBACK_URL=https://YOUR-APP-NAME.onrender.com/auth/google/callback

# ایمیل ادمین (ثابت)
ADMIN_EMAIL=shapyaar@gmail.com
